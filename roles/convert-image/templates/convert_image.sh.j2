#!/bin/bash

set -eux

FS_TYPE=`findmnt -o FSTYPE -fn /`

if [ "$FS_TYPE" = "xfs" ]; then
    xfs_growfs /
elif [ "$FS_TYPE" = "ext4" ]; then
    resize2fs {{ guest_partition }} || true
else
    echo "ERROR: Unknown filesystem, cannot resize."
    exit 1
fi

{% if convert_image_fix_uefi_boot|default(true)|bool %}
# Fix UEFI local boot for this image. The dib build leaves a minimal
# grub.cfg at /boot/efi/EFI/centos/grub.cfg (the template that gets
# copied onto the ESP created at deploy time) which does:
#
#     search --no-floppy --set prefix --file /grub2/grub.cfg
#     set prefix=($prefix)/grub2
#     configfile $prefix/grub.cfg
#
# That chain only resolves when /boot is a SEPARATE partition holding
# /grub2/grub.cfg at its root. This image keeps /boot inside the root
# filesystem, so the search finds nothing and grub drops to a bare
# "grub>" prompt (observed on attempt 7: nodes provisioned to ironic
# "active" but never booted, deploy wait timed out).
#
# Replace it with a loader that finds the real grub2-mkconfig config on
# this image's layout (/boot inside the root filesystem) and mirrors the
# semantics of the working chain (root and prefix pointing at the
# directory tree that holds the real grub.cfg, which the grub binary
# then loads and renders its BLS menu from). Do NOT instead create a
# /grub2 symlink at the filesystem root: libguestfs inspection
# classifies any filesystem containing /grub2/grub.cfg as a boot
# partition rather than an OS root, which breaks virt-cat/
# virt-customize inspection of the image ("no operating system was
# found", attempt 8).
if [ -f /boot/efi/EFI/centos/grub.cfg ] && [ -f /boot/grub2/grub.cfg ]; then
cat >/boot/efi/EFI/centos/grub.cfg<<'EOF_GRUB'
search --no-floppy --set=root --file /boot/grub2/grub.cfg
set prefix=($root)/boot/grub2
configfile ($root)/boot/grub2/grub.cfg
EOF_GRUB
fi
# The BLS entries in /boot/loader/entries hard-code the root filesystem
# UUID captured when the image was built, which does not match the UUID
# of the final image; the kernel would not find its root device. Point
# them at the filesystem LABEL instead (fstab already mounts / by the
# same label).
if [ -d /boot/loader/entries ]; then
    sed -i 's/root=UUID=[0-9a-f-]\{36\}/root=LABEL=img-rootfs/' /boot/loader/entries/*.conf
fi
{% endif %}

{% if not undercloud_setup|bool %}

{{ ansible_pkg_mgr }} clean all
{% if convert_image_update|bool %}
{{ ansible_pkg_mgr }} update -y
{% endif %}

{{ ansible_pkg_mgr }} remove -y {{ convert_image_remove_pkgs|join(" ") }}
{% for pkg in convert_image_nodeps_pkgs|default([]) %}
# Install {{ pkg }} without honoring its dependencies: its dependency chain
# cannot resolve on a frozen release image against the moving distro repos
# (ansible-tripleo-ipa pulls ansible-freeipa, which requires the distro
# ansible-core with epoch 1, unsatisfiable where openstack-ansible-core
# obsoletes ansible-core and provides it without an epoch). The skipped
# dependencies (freeipa/TLS deployment bits) are not used by this
# deployment.
{{ ansible_pkg_mgr }} download -y {{ pkg }}
rpm -ivh --nodeps {{ pkg }}-*.noarch.rpm
rm -f {{ pkg }}-*.noarch.rpm
{% endfor %}
{{ ansible_pkg_mgr }} install -y {{ convert_image_install_pkgs|join(" ") }}
{% if convert_image_tempest_plugins is defined and convert_image_tempest_plugins|length %}
{# keep plugins install isolated from previous yum install to ease debugging #}
{{ ansible_pkg_mgr }} install -y {{ convert_image_tempest_plugins|join(" ") }}
{% endif %}

{% endif %}

{% if overcloud_as_undercloud|bool %}
# Create ifcfg file if not exist, as it's removed in overcloud prep
# https://review.opendev.org/q/I3b8cb5f8c413c109da1228878db9cff4d439273b
if [ ! -f /etc/sysconfig/network-scripts/ifcfg-eth0 ]; then
cat >/etc/sysconfig/network-scripts/ifcfg-eth0<<EOF
DEVICE="eth0"
BOOTPROTO="dhcp"
ONBOOT="yes"
TYPE="Ethernet"
EOF
fi
{% endif %}

useradd {{ undercloud_user }}
echo "{{ undercloud_user }} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/{{ undercloud_user }}
chmod 0440 /etc/sudoers.d/{{ undercloud_user }}

mkdir /home/{{ undercloud_user }}/.ssh

echo "127.0.0.1  undercloud localhost" > /etc/hosts
echo "HOSTNAME=undercloud" >> /etc/sysconfig/network
echo "undercloud" > /etc/hostname

chown -R {{ undercloud_user }}:{{ undercloud_user }} /home/{{ undercloud_user }}/

# Add a 4GB swap file to the Undercloud
dd if=/dev/zero of=/swapfile bs=1024 count=4194304
mkswap /swapfile
chmod 600 /swapfile
# Enable it on start
echo "/swapfile swap swap defaults 0 0" >> /etc/fstab

{% if not selinux_enforcing|bool %}

sed -i 's/SELINUX=enforcing/SELINUX=permissive/' /etc/selinux/config

{% endif %}
